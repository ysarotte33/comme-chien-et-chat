---
export interface Props {
  author: string;
  datePublished: string;
  dateModified: string;
  category: string;
  keyword: string;
}

const { author, datePublished, dateModified, category, keyword } = Astro.props;

const categoryLabels: Record<string, string> = {
  'arbre-a-chat': 'Arbre à chat',
  'fontaine-eau-chat': 'Fontaine à eau',
  'distributeur-croquettes-chat': 'Distributeur',
  'bac-litiere-chat': 'Bac à litière',
  'sac-a-dos-chat': 'Sac à dos',
};

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
}
---

<div class="article-meta">
  <span class="article-meta__eyebrow">{categoryLabels[category] ?? category}</span>
  <div class="article-meta__details">
    <span class="article-meta__author">Par <strong>{author}</strong></span>
    <span class="article-meta__sep">·</span>
    <time class="article-meta__date" datetime={datePublished}>
      Publié le {formatDate(datePublished)}
    </time>
    {dateModified !== datePublished && (
      <>
        <span class="article-meta__sep">·</span>
        <time class="article-meta__date" datetime={dateModified}>
          Mis à jour le {formatDate(dateModified)}
        </time>
      </>
    )}
  </div>
</div>

<style>
  .article-meta {
    margin-bottom: 2rem;
  }
  .article-meta__eyebrow {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-terracotta);
    margin-bottom: 0.5rem;
  }
  .article-meta__details {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-anthracite);
    opacity: 0.75;
  }
  .article-meta__sep {
    opacity: 0.4;
  }
</style>
