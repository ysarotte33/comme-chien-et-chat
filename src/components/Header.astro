---
// Header.astro — comme-chien-et-chat.com
// Charte : Fredoka (display) + Nunito Sans (body)
// Couleurs : Terracotta #D86C45 / Sauge #7FA081 / Crème #FBF4EA / Anthracite #2E2823

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const nav = [
  { label: 'Arbre à chat',      href: '/arbre-a-chat' },
  { label: 'Fontaine à eau',    href: '/fontaine-eau-chat' },
  { label: 'Distributeur',      href: '/distributeur-croquettes-chat' },
  { label: 'Bac à litière',     href: '/bac-litiere-chat' },
  { label: 'Sac à dos',         href: '/sac-a-dos-chat' },
];
---

<header class="site-header">
  <div class="container site-header__inner">

    <!-- Brand -->
    <a href="/" class="site-header__brand" aria-label="comme chien et chat — accueil">
      <!-- Icône SVG inline (pas de requête HTTP, optimal perf) -->
      <svg viewBox="0 0 230 175" width="46" height="35" aria-hidden="true" focusable="false">
        <g transform="translate(0,-15)">
          <!-- DOG -->
          <ellipse cx="121" cy="112" rx="16" ry="34" fill="#6B8C70" transform="rotate(-18 121 112)"/>
          <ellipse cx="185" cy="114" rx="16" ry="34" fill="#6B8C70" transform="rotate(18 185 114)"/>
          <circle cx="152" cy="120" r="46" fill="#7FA081"/>
          <ellipse cx="150" cy="140" rx="22" ry="17" fill="#FBF4EA"/>
          <ellipse cx="141" cy="112" rx="6.5" ry="7.5" fill="#FBF4EA"/>
          <ellipse cx="166" cy="112" rx="6.5" ry="7.5" fill="#FBF4EA"/>
          <circle cx="138.5" cy="113" r="3.4" fill="#3A332E"/>
          <circle cx="163.5" cy="113" r="3.4" fill="#3A332E"/>
          <ellipse cx="150" cy="131" rx="6.5" ry="5" fill="#3A332E"/>
          <path d="M150 135 Q150 145 142 145" stroke="#3A332E" stroke-width="3" fill="none" stroke-linecap="round"/>
          <path d="M150 135 Q150 145 158 145" stroke="#3A332E" stroke-width="3" fill="none" stroke-linecap="round"/>
          <!-- CAT -->
          <path d="M54 98 L62 54 L94 86 Z" fill="#D86C45" stroke="#D86C45" stroke-width="9" stroke-linejoin="round"/>
          <path d="M86 84 L110 52 L120 96 Z" fill="#D86C45" stroke="#D86C45" stroke-width="9" stroke-linejoin="round"/>
          <circle cx="82" cy="120" r="46" fill="#D86C45"/>
          <ellipse cx="68" cy="116" rx="6.5" ry="7.5" fill="#FBF4EA"/>
          <ellipse cx="95" cy="116" rx="6.5" ry="7.5" fill="#FBF4EA"/>
          <circle cx="70.5" cy="117" r="3.4" fill="#3A332E"/>
          <circle cx="97.5" cy="117" r="3.4" fill="#3A332E"/>
          <!-- Coeur -->
          <path d="M121 28 C116 21 106 22 106 30 C106 36 114 41 121 46 C128 41 136 36 136 30 C136 22 126 21 121 28 Z" fill="#E8825C"/>
        </g>
      </svg>
      <span class="site-header__wordmark">comme chien et chat</span>
    </a>

    <!-- Navigation principale -->
    <nav class="site-header__nav" aria-label="Navigation principale">
      {nav.map(item => (
        <a
          href={item.href}
          aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- CTA -->
    <div class="site-header__right">
      <a href="/arbre-a-chat" class="btn btn--primary">
        Nos guides
      </a>
    </div>

  </div>
</header>

<!-- Menu mobile -->
<style>
  @media (max-width: 768px) {
    .site-header__nav { display: none; }
    .site-header__right { display: none; }
  }
</style>
