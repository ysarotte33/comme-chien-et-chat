---
export interface Props {
  name: string;
  description: string;
  price?: string;
  rating?: number;
  href: string;
  imageAlt: string;
}

const { name, description, price, rating, href, imageAlt } = Astro.props;
---

<article class="product-card">
  <div class="product-card__img-wrap">
    <div class="product-card__img-placeholder" aria-label={imageAlt}></div>
  </div>
  <div class="product-card__body">
    {rating && (
      <div class="product-card__rating" aria-label={`Note : ${rating}/5`}>
        {'★'.repeat(Math.round(rating))}{'☆'.repeat(5 - Math.round(rating))}
        <span class="product-card__rating-num">{rating}/5</span>
      </div>
    )}
    <h3 class="product-card__name">{name}</h3>
    <p class="product-card__desc">{description}</p>
    {price && <p class="product-card__price">{price}</p>}
    <a href={href} class="product-card__cta btn btn--primary" rel="noopener" target="_blank">
      Voir le produit
    </a>
  </div>
</article>

<style>
  .product-card {
    background: var(--color-creme-card);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .product-card__img-wrap {
    aspect-ratio: 4/3;
    background: var(--color-creme);
  }
  .product-card__img-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-saumon) 0%, var(--color-creme) 100%);
  }
  .product-card__body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
  .product-card__rating {
    color: var(--color-terracotta);
    font-size: 1rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .product-card__rating-num {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-anthracite);
    opacity: 0.7;
  }
  .product-card__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-anthracite);
    margin: 0;
  }
  .product-card__desc {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--color-anthracite);
    opacity: 0.8;
    margin: 0;
    line-height: 1.5;
  }
  .product-card__price {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-terracotta);
    margin: 0;
  }
  .product-card__cta {
    margin-top: auto;
    text-align: center;
    text-decoration: none;
    display: inline-block;
  }
</style>
