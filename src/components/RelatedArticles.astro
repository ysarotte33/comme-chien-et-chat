---
export interface RelatedArticle {
  title: string;
  slug: string;
  category: string;
  description: string;
}

export interface Props {
  articles: RelatedArticle[];
}

const { articles } = Astro.props;
---

{articles.length > 0 && (
  <section class="related-articles">
    <h2 class="related-articles__title">Articles similaires</h2>
    <div class="related-articles__grid">
      {articles.map((article) => (
        <a href={`/${article.category}/${article.slug}`} class="related-card">
          <h3 class="related-card__title">{article.title}</h3>
          <p class="related-card__desc">{article.description}</p>
          <span class="related-card__cta">Lire l'article →</span>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-articles {
    margin: 3rem 0;
    padding-top: 2rem;
    border-top: 2px solid var(--color-creme);
  }
  .related-articles__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-anthracite);
    margin-bottom: 1.25rem;
  }
  .related-articles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--color-creme-card);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .related-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 24px 56px -24px rgba(46,40,35,0.36);
  }
  .related-card__title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-anthracite);
    margin: 0;
  }
  .related-card__desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-anthracite);
    opacity: 0.75;
    margin: 0;
    line-height: 1.5;
  }
  .related-card__cta {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-terracotta);
    margin-top: auto;
  }
</style>
