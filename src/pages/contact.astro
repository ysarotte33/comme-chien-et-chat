---
import BaseLayout from '../layouts/BaseLayout.astro';
import { generateBreadcrumbSchema } from '../utils/schema.ts';

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Accueil', url: 'https://comme-chien-et-chat.com' },
  { name: 'Contact', url: 'https://comme-chien-et-chat.com/contact' },
]);
---

<BaseLayout
  title="Contact — comme chien et chat"
  description="Contactez l'équipe de comme-chien-et-chat.com pour toute question, suggestion ou partenariat autour des accessoires pour chats."
  canonical="https://comme-chien-et-chat.com/contact"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="page-content">
    <div class="container page-content__inner">
      <span class="eyebrow">Nous écrire</span>
      <h1>Contact</h1>
      <p class="intro">
        Une question, une suggestion ou une collaboration en vue ? Utilisez le formulaire ci-dessous.
        Nous répondons sous 48 h ouvrées.
      </p>

      <form class="contact-form" action="#" method="POST">
        <div class="form-group">
          <label for="name" class="form-label">Nom</label>
          <input type="text" id="name" name="name" class="form-input" required autocomplete="name" />
        </div>
        <div class="form-group">
          <label for="email" class="form-label">Email</label>
          <input type="email" id="email" name="email" class="form-input" required autocomplete="email" />
        </div>
        <div class="form-group">
          <label for="message" class="form-label">Message</label>
          <textarea id="message" name="message" class="form-textarea" rows="6" required></textarea>
        </div>
        <button type="submit" class="btn btn--primary">Envoyer le message</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .page-content { padding: 3rem 0 5rem; background: var(--color-creme); min-height: 100vh; }
  .page-content__inner { max-width: 600px; }
  .eyebrow { display: inline-block; font-family: var(--font-body); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: var(--color-terracotta); margin-bottom: 0.75rem; }
  h1 { font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 3.25rem); font-weight: 600; color: var(--color-anthracite); margin: 0 0 1rem; }
  .intro { font-family: var(--font-body); font-size: 1.125rem; line-height: 1.65; color: var(--color-anthracite); opacity: 0.8; margin-bottom: 2.5rem; }
  .contact-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
  .form-label { font-family: var(--font-body); font-size: 0.9rem; font-weight: 700; color: var(--color-anthracite); }
  .form-input, .form-textarea { font-family: var(--font-body); font-size: 1rem; color: var(--color-anthracite); background: var(--color-creme-card); border: 2px solid rgba(46,40,35,0.15); border-radius: var(--radius-sm); padding: 0.75rem 1rem; outline: none; transition: border-color 0.2s; width: 100%; box-sizing: border-box; }
  .form-input:focus, .form-textarea:focus { border-color: var(--color-terracotta); }
  .form-textarea { resize: vertical; min-height: 140px; }
</style>
