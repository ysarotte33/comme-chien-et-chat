---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { generateCanonical } from '../../utils/seo.ts';

export async function getStaticPaths() {
  const articles = await getCollection('fontaine-eau-chat');
  return articles.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const canonical = generateCanonical(`/fontaine-eau-chat/${entry.slug}`);

let relatedArticles: { title: string; slug: string; category: string; description: string }[] = [];
if (entry.data.relatedArticles && entry.data.relatedArticles.length > 0) {
  const allArticles = await getCollection('fontaine-eau-chat');
  relatedArticles = allArticles
    .filter(a => entry.data.relatedArticles!.includes(a.slug))
    .map(a => ({
      title: a.data.title,
      slug: a.slug,
      category: a.data.category,
      description: a.data.description,
    }));
}
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  {canonical}
  article={{
    title: entry.data.title,
    description: entry.data.description,
    slug: entry.slug,
    category: entry.data.category,
    author: entry.data.author,
    datePublished: entry.data.datePublished,
    dateModified: entry.data.dateModified,
  }}
  faqs={entry.data.faqs}
  {relatedArticles}
  categoryLabel="Fontaine à eau"
  urlCibleGriffedamour={entry.data.urlCibleGriffedamour}
  ancreGriffedamour={entry.data.ancreGriffedamour}
>
  <Content />
</ArticleLayout>
