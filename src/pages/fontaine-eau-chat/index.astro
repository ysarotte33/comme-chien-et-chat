---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { generateBreadcrumbSchema } from '../../utils/schema.ts';

const articles = await getCollection('fontaine-eau-chat');
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Accueil', url: 'https://comme-chien-et-chat.com' },
  { name: 'Fontaine à eau', url: 'https://comme-chien-et-chat.com/fontaine-eau-chat' },
]);
---

<BaseLayout
  title="Fontaine à eau pour chat — Guides & Comparatifs"
  description="Tous nos guides sur les fontaines à eau pour chats : comparatifs, avis experts, conseils d'entretien. La bonne fontaine pour votre félin en 2025."
  canonical="https://comme-chien-et-chat.com/fontaine-eau-chat"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="category-page">
    <div class="container">
      <div class="category-hero">
        <span class="eyebrow">Univers</span>
        <h1>Fontaine à eau</h1>
        <p>Fontaines filtrantes et silencieuses pour encourager votre chat à bien s'hydrater au quotidien.</p>
      </div>

      {articles.length === 0 ? (
        <p class="empty-state">Les articles arrivent bientôt.</p>
      ) : (
        <div class="articles-grid">
          {articles.map(article => (
            <a href={`/fontaine-eau-chat/${article.slug}`} class="article-card">
              <span class="article-card__priority">{article.data.priorite}</span>
              <h2 class="article-card__title">{article.data.title}</h2>
              <p class="article-card__desc">{article.data.description}</p>
              <span class="article-card__cta">Lire →</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .category-page { padding: 3rem 0 5rem; background: var(--color-creme); min-height: 100vh; }
  .category-hero { text-align: center; margin-bottom: 3rem; }
  .eyebrow { display: inline-block; font-family: var(--font-body); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; color: var(--color-terracotta); margin-bottom: 0.75rem; }
  .category-hero h1 { font-family: var(--font-display); font-size: clamp(2.5rem, 5vw, 3.25rem); font-weight: 600; color: var(--color-anthracite); margin: 0 0 1rem; }
  .category-hero p { font-family: var(--font-body); font-size: 1.125rem; line-height: 1.65; color: var(--color-anthracite); opacity: 0.8; max-width: 600px; margin: 0 auto; }
  .articles-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }
  .article-card { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.5rem 1.75rem; background: var(--color-creme-card); border-radius: var(--radius-md); box-shadow: var(--shadow-card); text-decoration: none; transition: transform 0.2s; }
  .article-card:hover { transform: translateY(-2px); }
  .article-card__priority { font-family: var(--font-body); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-sauge); }
  .article-card__title { font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; color: var(--color-anthracite); margin: 0; }
  .article-card__desc { font-family: var(--font-body); font-size: 0.9rem; line-height: 1.5; color: var(--color-anthracite); opacity: 0.75; margin: 0; flex: 1; }
  .article-card__cta { font-family: var(--font-body); font-size: 0.875rem; font-weight: 700; color: var(--color-terracotta); }
  .empty-state { text-align: center; font-family: var(--font-body); color: var(--color-anthracite); opacity: 0.6; padding: 3rem; }
</style>
